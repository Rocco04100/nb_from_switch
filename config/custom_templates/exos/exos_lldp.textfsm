Value Required LOCAL_PORT (\d+)
Value HOSTNAME ([^"]+)
Value REMOTE_PORT ([^"]+|[0-9A-Fa-f:]+)
Value ENABLED_CAPABILITIES ([^"]+)

Start
  ^LLDP Port ${LOCAL_PORT} detected -> LLDP

LLDP
  ^\s+- System Name:\s+"${HOSTNAME}" -> Continue
  ^\s+Port ID\s+:\s+"?${REMOTE_PORT}"? -> Continue
  ^\s+Enabled Capabilities:\s+"${ENABLED_CAPABILITIES}" -> Continue
  ^LLDP Port -> Record LLDP
  ^$$ -> Record
